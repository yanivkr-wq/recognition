# packages/db/.env.test — local override for `pnpm --filter @reco/db test`.
# Copy to .env.test (gitignored) and adjust the connection string.
#
# Recommended setup: a SEPARATE database on the same throwaway pg container
# from RESUME-HERE.md (port 5433). The harness applies migrations once per
# process and TRUNCATEs between tests, so a dedicated DB stays clean.
#
# To create the test DB once:
#   docker exec reco-pg-smoke psql -U reco -d reco -c "CREATE DATABASE reco_test;"
#
# Then:
TEST_DATABASE_URL=postgres://reco:test@localhost:5433/reco_test
