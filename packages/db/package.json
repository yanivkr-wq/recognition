{
  "name": "@reco/db",
  "version": "0.1.0",
  "private": true,
  "description": "Reco database package — Drizzle schema, raw SQL migrations, encrypt helpers, migration runner.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test-utils": "./src/test-utils/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "migrate:apply": "tsx src/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@reco/shared": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
