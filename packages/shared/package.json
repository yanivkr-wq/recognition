{
  "name": "@reco/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Reco shared package — design tokens (brandbook as code), i18n dictionaries, shared types, format helpers.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./design-tokens": "./src/design-tokens/index.ts",
    "./design-tokens/css": "./src/design-tokens/css-variables.ts",
    "./design-tokens/tailwind": "./src/design-tokens/tailwind-preset.ts",
    "./i18n": "./src/i18n/index.ts",
    "./i18n/he": "./src/i18n/dictionaries/he.json",
    "./i18n/en": "./src/i18n/dictionaries/en.json",
    "./types": "./src/types/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
