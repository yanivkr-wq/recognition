{
  "name": "recognition",
  "version": "0.1.0",
  "private": true,
  "description": "Reco — bilingual (HE+EN) self-hosted PWA for kids' chores, rewards, and campaigns. Runs alongside Family_Budget_App and Family_Tasks_Hub on a single Hetzner CX32.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @reco/web dev",
    "dev:worker": "pnpm --filter @reco/worker dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,sql}\"",
    "migrate:apply": "pnpm --filter @reco/db migrate:apply",
    "db:psql": "docker exec -it reco-pg psql -U reco -d reco",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
