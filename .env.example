# ============================================================================
# Reco — Environment Variables (example)
# Copy to .env (production) or .env.local (dev) and fill in.
# Production .env is generated by infra/deploy-prod.sh — don't hand-edit it.
# ============================================================================

NODE_ENV=development
TZ=Asia/Jerusalem
APP_URL=http://localhost:3030

# ── Postgres ─────────────────────────────────────────────────────────────────
# In prod, deploy-prod.sh generates the password. In dev, use devpass.
POSTGRES_PASSWORD=devpass
DATABASE_URL=postgres://reco:devpass@localhost:5432/reco

# ── Secrets (generate with: openssl rand -base64 32) ─────────────────────────
# MASTER_KEY: 32 random bytes base64-encoded. Encrypts kid PIN salts + device
#             trust tokens. Lost key = unrecoverable. Back up to password manager.
MASTER_KEY=
# AUTH_SECRET: Auth.js v5 session signing key. Any random 32+ bytes.
AUTH_SECRET=
AUTH_URL=http://localhost:3030
AUTH_TRUST_HOST=true
# WORKER_INTERNAL_TOKEN: shared secret for web→worker private API calls.
WORKER_INTERNAL_TOKEN=

# ── Twilio Sandbox (WhatsApp outbound only) ──────────────────────────────────
# Same account as Family_Tasks_Hub and Family_Budget_App. Reco writes its own
# outbound code; no inbound webhook (account-singleton owned by tasks-hub).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Gmail SMTP (parent password reset + optional daily summary email) ────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Backblaze B2 backups ─────────────────────────────────────────────────────
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
B2_BUCKET_DB=reco-backups
B2_BUCKET_EVIDENCE=reco-evidence-backup
B2_KEY_ID=
B2_APP_KEY=
DB_BACKUP_RETENTION_DAYS=30
EVIDENCE_BACKUP_RETENTION_WEEKS=4

# ── Anthropic API (no AI features in v1; key minted for v2 readiness) ────────
ANTHROPIC_API_KEY=

# ── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN_WEB=
SENTRY_DSN_WORKER=
SENTRY_ENVIRONMENT=development

# ── Cron schedules (overridable per env; see /docs/CRON.md for defaults) ─────
DISPATCHER_CRON=*/5 * * * *
DAILY_RESET_CRON=0 0 * * *
CAMPAIGN_WINDOW_CRON=0 1 * * *
DB_BACKUP_CRON=0 4 * * *
EVIDENCE_BACKUP_CRON=0 5 * * 0
EVIDENCE_PURGE_CRON=0 6 * * *
SUMMARY_CRON=0 9 * * *
SUMMARY_ENABLED=false

# ── Notification routing ─────────────────────────────────────────────────────
WHATSAPP_DRY_RUN=true   # in dev, log Twilio calls instead of sending
DEFAULT_QUIET_HOURS_START=21:00
DEFAULT_QUIET_HOURS_END=07:00
WHATSAPP_RATE_LIMIT_PER_10MIN=3

# ── Evidence storage volume (Docker volume mount path inside containers) ─────
# Reward images live in a `rewards/` subdirectory of this same volume — see
# Gate 2 §Q3. The evidence-purge cron is row-driven against the `evidence`
# table, so it never touches reward image files.
EVIDENCE_VOLUME_PATH=/var/lib/reco/evidence
