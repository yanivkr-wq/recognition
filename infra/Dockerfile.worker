# syntax=docker/dockerfile:1.7

# Reco worker — Fastify 5 served via tsx (no separate build step).
#
# Single stage: copy the worker + its workspace deps, pnpm install with the
# transitive workspace closure, then run `tsx src/server.ts` directly.
# `tsx` is a dev-dependency by package convention but we keep it installed
# in production because the worker uses it as the runtime. Image is ~250 MB
# which is a deliberate trade vs writing a bundler config for this app.

FROM node:22-alpine
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# Manifests first for layer-cache friendliness.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/worker/package.json ./apps/worker/
COPY packages/db/package.json ./packages/db/
COPY packages/shared/package.json ./packages/shared/

# Install the worker's transitive closure only (skip @reco/web's deps).
# `--filter @reco/worker...` = the worker + every workspace package it depends on.
RUN pnpm install --frozen-lockfile --filter @reco/worker...

# Now bring in the source for everything the worker actually imports.
COPY apps/worker ./apps/worker
COPY packages/db ./packages/db
COPY packages/shared ./packages/shared

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
EXPOSE 8100

# Drop privileges. Evidence volume mount must be writable by uid 1001.
RUN addgroup --system --gid 1001 reco \
    && adduser --system --uid 1001 --ingroup reco reco \
    && mkdir -p /var/lib/reco/evidence \
    && chown -R reco:reco /var/lib/reco /app
USER reco

WORKDIR /app/apps/worker
CMD ["pnpm", "start"]
